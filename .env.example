# Copy to .env and fill in. Never commit .env (NFR-23).
DATABASE_URL="file:./vuln.db"
# Fixed base URL used for every link in emails (NFR-19). Must be https in production.
APP_BASE_URL="http://localhost:3000"
# At least 32 random bytes, e.g. `openssl rand -base64 48`
SERVER_SECRET=""
# Where security alerts go (NFR-13, NFR-15)
ADMIN_EMAIL="admin@spendwise.local"
# Development mail transport: emails are written to this file instead of being sent
MAIL_OUTBOX="./data/outbox.jsonl"
